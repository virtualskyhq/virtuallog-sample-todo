# Server
PORT=3000

# VirtualLog ingest endpoint (optional — leave empty to only console.log)
# Server logger reads this
VIRTUALLOG_ENDPOINT=

# VirtualLog API key (required if VIRTUALLOG_ENDPOINT is set)
VIRTUALLOG_API_KEY=

# Optional: pre-fill the "VirtualLog domain" field of the browser setup screen.
# The browser is configured at runtime — this just saves a paste.
VITE_VIRTUALLOG_ENDPOINT=
